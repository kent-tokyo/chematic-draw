# =============================================================================
# Rust / Cargo
# =============================================================================
# Build artifacts
/target/
**/target/

# NOTE: Cargo.lock IS intentionally tracked.
# This is a binary application crate — Cargo.lock should be committed.
# See: https://doc.rust-lang.org/cargo/faq.html#why-do-binaries-have-cargolock-in-version-control-but-not-libraries

# Rust incremental compilation backup files
**/*.rs.bk

# Cargo published crate tarballs
*.crate

# Compiled debug info / profiling symbols (Windows)
*.pdb

# Dependency build files (auto-generated by rustc)
*.d

# =============================================================================
# Sensitive / local configuration
# =============================================================================
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
secrets.toml
secrets.json

