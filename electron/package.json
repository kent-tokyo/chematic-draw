{
  "name": "chematic-draw",
  "productName": "Chematic Draw",
  "version": "0.5.4",
  "description": "chematic-draw — Electron/WASM chemical structure editor",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build:wasm": "cd .. && wasm-pack build crates/chem-wasm --target web --out-dir ../../electron/src/renderer/wasm/pkg --out-name chem_wasm",
    "build:wasm:release": "cd .. && wasm-pack build crates/chem-wasm --target web --release --out-dir ../../electron/src/renderer/wasm/pkg --out-name chem_wasm",
    "build:wasm:test": "cd .. && wasm-pack build crates/chem-wasm --target nodejs --out-dir ../../electron/src/renderer/wasm/pkg-node --out-name chem_wasm && cd electron && npm pkg set name=chem-wasm-node-test --prefix src/renderer/wasm/pkg-node",
    "test": "jest --testPathIgnorePatterns='\\.bench\\.ts$'",
    "test:unit": "jest --testPathIgnorePatterns='\\.bench\\.ts$'",
    "test:watch": "jest --watch --testPathIgnorePatterns='\\.bench\\.ts$'",
    "test:coverage": "jest --coverage --testPathIgnorePatterns='\\.bench\\.ts$'",
    "test:perf": "jest --testPathPatterns='\\.bench\\.ts$'",
    "test:e2e": "playwright test --project=renderer-e2e",
    "test:e2e:electron": "playwright test --project=electron-smoke",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "keywords": [],
  "author": {
    "name": "Kentaro Tanabe",
    "email": "ke.tanabe@gmail.com"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.0.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "7.3.6",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}
